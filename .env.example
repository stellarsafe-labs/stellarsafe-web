# Data source: "demo" runs a simulated contract in the browser (no backend needed).
# "live" reads Soroban RPC + stellarsafe-api and signs with the user's wallet.
NEXT_PUBLIC_DATA_SOURCE=demo

# testnet | futurenet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Required when NEXT_PUBLIC_DATA_SOURCE=live
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_API_URL=
# Factory contract used to deploy new treasuries (live mode)
NEXT_PUBLIC_FACTORY_CONTRACT_ID=

# Optional
NEXT_PUBLIC_HORIZON_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: endpoint that receives client error reports (JSON POST). Nothing is sent when unset.
NEXT_PUBLIC_ERROR_REPORT_URL=
NEXT_PUBLIC_RELEASE=

# Safety switch: the app refuses to start against mainnet unless this is "true".
# Only enable after the contracts have passed an independent security review.
NEXT_PUBLIC_ALLOW_MAINNET=false
